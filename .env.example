# 이 파일을 .env 로 복사한 뒤 값을 채우십시오. .env 는 커밋하지 않습니다.
#
#   cp .env.example .env
#
# 아래 세 값은 docker compose 가 비어 있으면 기동을 거부합니다.

# 라운드 토큰 서명과 사번 해시에 쓰는 비밀키.
# 이 값이 바뀌면 이미 발급된 토큰이 무효가 되고, 같은 사번도 다른 해시가 되어
# 중복 참가 확인이 끊깁니다. 행사 중에는 바꾸지 마십시오.
#   openssl rand -hex 32
APP_SECRET=

# 운영자 콘솔(/api/admin/flagged) 접근 토큰. 비어 있으면 해당 API가 잠깁니다.
#   openssl rand -hex 16
ADMIN_TOKEN=

# Postgres 비밀번호. docker-compose 가 DB 계정과 DATABASE_URL 양쪽에 씁니다.
DB_PASSWORD=

# ---------------------------------------------------------------- 선택
# 아래는 기본값이 있어 비워 둬도 됩니다.

# 서버 포트 (기본 8787)
# PORT=8787

# 바인딩 주소 (기본 0.0.0.0). 컨테이너 안에서는 0.0.0.0 이어야 밖에서 붙습니다.
# HOST=0.0.0.0

# 라운드 토큰 유효 시간(ms). 기본 5분 — 라운드 77초보다 넉넉해야 합니다.
# TOKEN_TTL_MS=300000

# 1인 최대 제출 횟수 (기본 3)
# MAX_ROUNDS=3

# 직접 띄운 Postgres 를 쓸 때만. 비우면 메모리 저장소로 뜨고 재시작 시 기록이
# 사라집니다. docker compose 를 쓰면 compose 가 이 값을 만들어 넣습니다.
# DATABASE_URL=postgres://minwon:비밀번호@localhost:5432/minwon

# 프론트를 백엔드와 다른 호스트에 올릴 때만 필요합니다. 한 컨테이너로 서빙하면
# 같은 출처이므로 비워 두십시오. 빌드 시점에 번들에 박힙니다.
# VITE_API_BASE=https://minwon.example.kipi.or.kr

# 프론트 개발 서버에서만 씁니다. 비워 두면 vite 프록시가 8787로 넘겨 주므로
# 보통 불필요하고, 백엔드를 다른 포트로 띄웠을 때만 지정하십시오.
# API_TARGET=http://localhost:8787
